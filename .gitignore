# --- Secrets: never commit ---
publish-token.txt
**/publish-token.txt
*.token
*.pat
 
# --- GM / private campaign material: must never reach the public repo ---
# The published Companion is player-safe; build.py skips these if absent.
*_GM.md
_SESSION_LOG.md
 
# --- Author-only working material (not read by the player build) ---
sheets/
builds/sources/
builds/reports/
*.pdf
 
# --- Build output & local cruft ---
dist/
**/__pycache__/
*.pyc
.DS_Store
# CH-12: locally cached pyodide CDN assets for the DOM smoke test (14MB, 6 files).
# The comment is on its own line on purpose: .gitignore has no trailing comments, so
# "path/  # note" is read as a literal pattern and ignores nothing.
.pyodide-cache/
 
